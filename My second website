
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>URBAN CULTURE | Fashion Store</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f7f7f7;
      color: #171717;
    }

    header {
      background: #111;
      color: white;
      padding: 22px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: 2px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 20px;
      font-size: 13px;
    }

    .hero {
      min-height: 480px;
      background:
        linear-gradient(90deg, #000b, #0002),
        url('https://images.unsplash.com/photo-1523398002811-999ca8dec234?w=1400');
      background-size: cover;
      background-position: center;
      color: white;
      display: flex;
      align-items: center;
      padding: 8%;
    }

    .hero-content {
      max-width: 500px;
    }

    .hero h1 {
      font-size: clamp(42px, 8vw, 75px);
      line-height: 1;
      margin-bottom: 20px;
    }

    .hero p {
      margin-bottom: 25px;
      line-height: 1.7;
    }

    .btn {
      display: inline-block;
      background: white;
      color: black;
      padding: 14px 25px;
      text-decoration: none;
      font-weight: bold;
      border: none;
      cursor: pointer;
    }

    .section {
      padding: 65px 7%;
    }

    .section h2 {
      text-align: center;
      font-size: 30px;
      margin-bottom: 35px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .product {
      background: white;
      padding-bottom: 20px;
    }

    .product img {
      width: 100%;
      height: 300px;
      object-fit: cover;
    }

    .product h3,
    .product p {
      margin: 12px 15px;
    }

    .price {
      font-weight: bold;
    }

    .product button {
      margin: 5px 15px;
      background: #111;
      color: white;
      padding: 12px;
      width: calc(100% - 30px);
      border: none;
      cursor: pointer;
    }

    .about {
      background: #111;
      color: white;
      text-align: center;
      padding: 65px 10%;
      line-height: 1.8;
    }

    footer {
      background: #080808;
      color: white;
      text-align: center;
      padding: 25px;
      font-size: 13px;
    }

    @media(max-width: 700px) {
      nav a {
        margin-left: 8px;
        font-size: 11px;
      }

      .products {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }

      .product img {
        height: 210px;
      }

      .section {
        padding: 45px 4%;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">URBAN CULTURE.</div>
    <nav>
      <a href="#home">Home</a>
      <a href="#shop">Shop</a>
      <a href="#about">About</a>
    </nav>
  </header>

  <section class="hero" id="home">
    <div class="hero-content">
      <h1>DEFINE YOUR STYLE.</h1>
      <p>Discover modern streetwear, premium outfits and everyday fashion made for your lifestyle.</p>
      <a href="#shop" class="btn">EXPLORE COLLECTION</a>
    </div>
  </section>

  <section class="section" id="shop">
    <h2>OUR COLLECTION</h2>

    <div class="products">

      <div class="product">
        <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=600" alt="Classic T-shirt">
        <h3>Classic Street Tee</h3>
        <p class="price">₦15,000</p>
        <button onclick="order('Classic Street Tee')">ORDER NOW</button>
      </div>

      <div class="product">
        <img src="https://images.unsplash.com/photo-1551028719-00167b16eac5?w=600" alt="Fashion jacket">
        <h3>Urban Jacket</h3>
        <p class="price">₦35,000</p>
        <button onclick="order('Urban Jacket')">ORDER NOW</button>
      </div>

      <div class="product">
        <img src="https://images.unsplash.com/photo-1542272604-787c3835535d?w=600" alt="Fashion jeans">
        <h3>Classic Denim</h3>
        <p class="price">₦25,000</p>
        <button onclick="order('Classic Denim')">ORDER NOW</button>
      </div>

    </div>
  </section>

  <section class="about" id="about">
    <h2>ABOUT URBAN CULTURE</h2>
    <p>
      Fashion is more than what you wear. It's how you express yourself.
      We bring you stylish, modern and comfortable fashion for every occasion.
    </p>
  </section>

  <footer>
    <p>© 2026 URBAN CULTURE. All Rights Reserved.</p>
    <p>Style Without Limits.</p>
  </footer>

  <script>
    function order(product) {
      const message = "Hello, I want to order " + product;
      const phone = "2348000000000";
      window.open(
        "https://wa.me/" + phone + "?text=" + encodeURIComponent(message),
        "_blank"
      );
    }
  </script>

</body>
</html>
